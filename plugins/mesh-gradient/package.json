{
  "name": "rift-plugin-mesh-gradient",
  "version": "0.1.0",
  "description": "Design, preview, and export mesh gradients from rift.",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "assets",
    "dist",
    "docs",
    "themes",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tooling/build-plugin.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "rift": ">=0.0.34",
    "riftPluginSdk": ">=0.4.48"
  },
  "rift": {
    "name": "Mesh Gradient",
    "description": "Design, preview, and export mesh gradients from rift.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [],
    "themes": [
      {
        "id": "aurora",
        "name": "Mesh Aurora",
        "description": "Green-to-violet, from the aurora palette",
        "css": "./themes/aurora.css"
      },
      {
        "id": "sunset",
        "name": "Mesh Sunset",
        "description": "Warm amber and rose, from the sunset palette",
        "css": "./themes/sunset.css"
      },
      {
        "id": "ocean",
        "name": "Mesh Ocean",
        "description": "Teal and indigo, from the ocean palette",
        "css": "./themes/ocean.css"
      },
      {
        "id": "candy",
        "name": "Mesh Candy",
        "description": "Bright pink and violet, from the candy palette",
        "css": "./themes/candy.css"
      },
      {
        "id": "forest",
        "name": "Mesh Forest",
        "description": "Muted greens, from the forest palette",
        "css": "./themes/forest.css"
      },
      {
        "id": "mono",
        "name": "Mesh Mono",
        "description": "Single-hue neutral, from the mono palette",
        "css": "./themes/mono.css"
      }
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@riftlabs/plugin-sdk": "0.4.48",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.28.0",
    "hono": "^4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.8"
  }
}
